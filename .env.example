# Square production credentials. Never expose the access token with NEXT_PUBLIC_.
SQUARE_ENVIRONMENT=production
SQUARE_ACCESS_TOKEN=
SQUARE_API_VERSION=2026-07-15
SQUARE_LOCATION_ID=

# Catalog ITEM_VARIATION IDs for each bookable service in Square.
# Vehicle-priced packages require one exact variation per tier.
SQUARE_SERVICE_FAMILY_INTERIOR_RESET_CAR=
SQUARE_SERVICE_FAMILY_INTERIOR_RESET_MIDSIZE_SUV=
SQUARE_SERVICE_FAMILY_INTERIOR_RESET_THREE_ROW=
SQUARE_SERVICE_COMPLETE_MOBILE_DETAIL_CAR=
SQUARE_SERVICE_COMPLETE_MOBILE_DETAIL_MIDSIZE_SUV=
SQUARE_SERVICE_COMPLETE_MOBILE_DETAIL_THREE_ROW=
SQUARE_SERVICE_RESTORE_PROTECT_CAR=
SQUARE_SERVICE_RESTORE_PROTECT_MIDSIZE_SUV=
SQUARE_SERVICE_RESTORE_PROTECT_THREE_ROW=
SQUARE_SERVICE_MAINTENANCE_CAR=
SQUARE_SERVICE_MAINTENANCE_MIDSIZE_SUV=
SQUARE_SERVICE_MAINTENANCE_THREE_ROW=

# Optional comma-separated Square team member IDs. If blank, the app loads
# all bookable profiles from the Bookings API.
SQUARE_TEAM_MEMBER_IDS=
